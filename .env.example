# Copia como .env para uso local, o define como "fly secrets set" en remoto.

CENDOJ_HEADLESS=true

# Token requerido para acceder al servidor en modo remoto (run.py api /
# Docker / Fly.io). Sin este token, todas las rutas salvo /api/status
# devuelven 503. Genera uno largo y aleatorio, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CENDOJ_API_TOKEN=
